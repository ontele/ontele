{
  "uid": "ontele-overview",
  "title": "Ontele",
  "tags": ["ontele", "media"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      { "name": "app", "type": "constant", "query": "ontele", "hide": 2 }
    ]
  },
  "panels": [
    { "type": "row", "title": "Right now", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "id": 100, "collapsed": false },
    { "id": 1, "type": "stat", "title": "Active streams", "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "max(ontele_streams_active{mode=\"all\"})", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#ffb454" }, "unit": "none" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 2, "type": "stat", "title": "Transcodes", "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "max(ontele_transcodes_active)", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#ff6b4a" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 3, "type": "stat", "title": "Recording", "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "max(ontele_recordings_active)", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#ff4d5e" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 4, "type": "stat", "title": "Requests / s", "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(ontele_http_requests_total[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 5, "type": "stat", "title": "5xx rate", "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(ontele_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(ontele_http_requests_total[5m])), 1e-9)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } } },
    { "id": 6, "type": "stat", "title": "Library", "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "ontele_library_items", "legendFormat": "{{kind}}", "refId": "A" }],
      "options": { "colorMode": "none", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"] } } },

    { "type": "row", "title": "HTTP", "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 }, "id": 101, "collapsed": false },
    { "id": 10, "type": "timeseries", "title": "Requests by route", "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "topk(12, sum by (route) (rate(ontele_http_requests_total[$__rate_interval])))", "legendFormat": "{{route}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 12, "lineWidth": 1, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean"] } } },
    { "id": 11, "type": "timeseries", "title": "Latency p50 / p95 / p99", "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(ontele_http_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(ontele_http_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(ontele_http_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }, "overrides": [] } },
    { "id": 12, "type": "timeseries", "title": "Status codes", "gridPos": { "x": 0, "y": 14, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (status) (rate(ontele_http_requests_total[$__rate_interval]))", "legendFormat": "{{status}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "2.." }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#5ad19a" } }] },
          { "matcher": { "id": "byRegexp", "options": "4.." }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#ffb454" } }] },
          { "matcher": { "id": "byRegexp", "options": "5.." }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#ff4d5e" } }] }
        ] } },
    { "id": 13, "type": "timeseries", "title": "Playback starts by mode", "gridPos": { "x": 12, "y": 14, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (mode) (increase(ontele_playback_starts_total[$__rate_interval]))", "legendFormat": "{{mode}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] } },

    { "type": "row", "title": "Activity (Loki)", "gridPos": { "x": 0, "y": 21, "w": 24, "h": 1 }, "id": 102, "collapsed": false },
    { "id": 20, "type": "timeseries", "title": "Activity events by kind", "gridPos": { "x": 0, "y": 22, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "sum by (kind) (count_over_time({app=\"ontele\", target=\"ontele.activity\"} | json [$__auto]))", "legendFormat": "{{kind}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 70, "stacking": { "mode": "normal" } } }, "overrides": [] } },
    { "id": 21, "type": "timeseries", "title": "Warnings & errors", "gridPos": { "x": 12, "y": 22, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "sum(count_over_time({app=\"ontele\", level=\"WARN\"} [$__auto]))", "legendFormat": "warn", "refId": "A" },
        { "expr": "sum(count_over_time({app=\"ontele\", level=\"ERROR\"} [$__auto]))", "legendFormat": "error", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 70 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "warn" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#ffb454" } }] },
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#ff4d5e" } }] }
        ] } },
    { "id": 22, "type": "logs", "title": "Activity stream", "gridPos": { "x": 0, "y": 30, "w": 12, "h": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{app=\"ontele\", target=\"ontele.activity\"} | json | line_format \"{{.kind}}  user={{.user_id}} item={{.item_id}} {{.detail}}\"", "refId": "A" }],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "dedupStrategy": "none", "enableLogDetails": true } },
    { "id": 23, "type": "logs", "title": "Server log", "gridPos": { "x": 12, "y": 30, "w": 12, "h": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{app=\"ontele\"} | json | target != \"ontele.http\" | line_format \"{{.level}} {{.target}} {{.message}} {{.error}}\"", "refId": "A" }],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true } },
    { "id": 24, "type": "logs", "title": "HTTP access log (slow & failed)", "gridPos": { "x": 0, "y": 42, "w": 24, "h": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{app=\"ontele\", target=\"ontele.http\"} | json | status >= 400 or ms > 1000 | line_format \"{{.status}} {{.method}} {{.path}} {{.ms}}ms user={{.user}} ip={{.ip}}\"", "refId": "A" }],
      "options": { "showTime": true, "wrapLogMessage": false, "sortOrder": "Descending" } },

    { "type": "row", "title": "Background work", "gridPos": { "x": 0, "y": 51, "w": 24, "h": 1 }, "id": 103, "collapsed": false },
    { "id": 30, "type": "timeseries", "title": "Library scan duration", "gridPos": { "x": 0, "y": 52, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "rate(ontele_scan_duration_seconds_sum[$__rate_interval]) / clamp_min(rate(ontele_scan_duration_seconds_count[$__rate_interval]), 1e-9)", "legendFormat": "avg scan", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] } },
    { "id": 31, "type": "timeseries", "title": "Metadata lookups", "gridPos": { "x": 8, "y": 52, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (provider, result) (increase(ontele_metadata_lookups_total[$__rate_interval]))", "legendFormat": "{{provider}} {{result}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } }, "overrides": [] } },
    { "id": 32, "type": "timeseries", "title": "Commercial scans", "gridPos": { "x": 16, "y": 52, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (detector, result) (increase(ontele_commercial_scans_total[$__rate_interval]))", "legendFormat": "{{detector}} {{result}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] } }
  ]
}
