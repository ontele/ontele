{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ontele chart values",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository"
      ]
    },
    "resources": {
      "type": "object"
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storageClass": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|k|m)?$"
        }
      }
    },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "hostPath": {
          "type": "string"
        },
        "nfs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "server": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          }
        },
        "readOnly": {
          "type": "boolean"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOnce",
              "ReadOnlyMany",
              "ReadWriteMany",
              "ReadWriteOncePod"
            ]
          }
        },
        "size": {
          "type": "string"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOnce",
              "ReadOnlyMany",
              "ReadWriteMany",
              "ReadWriteOncePod"
            ]
          }
        },
        "size": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "$ref": "#/$defs/image"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auth": {
          "type": "string",
          "enum": [
            "proxy",
            "none"
          ]
        },
        "adminUsers": {
          "type": "string"
        },
        "adminGroups": {
          "type": "string"
        },
        "hdhrIp": {
          "type": "string"
        },
        "xmltv": {
          "type": "string"
        },
        "commercials": {
          "type": "string",
          "enum": [
            "off",
            "skip",
            "delete"
          ]
        },
        "tmdbApiKey": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "logFormat": {
          "type": "string",
          "enum": [
            "json",
            "pretty"
          ]
        },
        "rustLog": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "mediaDirs": {
          "type": "string"
        },
        "musicDirs": {
          "type": "string"
        },
        "dvrPostCmd": {
          "type": "string"
        }
      }
    },
    "hostNetwork": {
      "type": "boolean"
    },
    "dri": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostPath": {
          "type": "string"
        },
        "supplementalGroups": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/claim"
        },
        "recordings": {
          "$ref": "#/$defs/claim"
        },
        "media": {
          "$ref": "#/$defs/library"
        },
        "music": {
          "$ref": "#/$defs/library"
        },
        "tmpSizeLimit": {
          "type": "string"
        }
      }
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "resources": {
      "$ref": "#/$defs/resources"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        },
        "nodePort": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "annotations": {
          "type": "object"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            }
          }
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "tls": {
          "type": "boolean"
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            }
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "username": {
              "type": "string",
              "minLength": 1
            },
            "database": {
              "type": "string",
              "minLength": 1
            },
            "password": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            }
          }
        },
        "persistence": {
          "$ref": "#/$defs/storage"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "externalDatabase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string"
        }
      }
    },
    "oauth2Proxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "provider": {
          "type": "string"
        },
        "oidcIssuerUrl": {
          "type": "string"
        },
        "clientId": {
          "type": "string"
        },
        "clientSecret": {
          "type": "string"
        },
        "cookieSecret": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "emailDomains": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "cookieName": {
          "type": "string"
        },
        "cookieExpire": {
          "type": "string"
        },
        "cookieRefresh": {
          "type": "string"
        },
        "redirectUrl": {
          "type": "string"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "nodePort": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {
              "type": "object"
            }
          }
        }
      }
    },
    "dex": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "clientSecret": {
          "type": "string",
          "minLength": 8
        },
        "staticPasswords": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "email",
              "username",
              "userID",
              "hash"
            ],
            "properties": {
              "email": {
                "type": "string"
              },
              "username": {
                "type": "string"
              },
              "userID": {
                "type": "string"
              },
              "hash": {
                "type": "string",
                "pattern": "^\\$2[aby]\\$"
              }
            }
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "autoscaling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 100
            },
            "targetMemoryUtilizationPercentage": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      }
    },
    "loki": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "persistence": {
          "$ref": "#/$defs/storage"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "promtail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "lokiUrl": {
          "type": "string"
        },
        "rbac": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            }
          }
        },
        "tolerations": {
          "type": "array"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "prometheus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "retention": {
          "type": "string"
        },
        "persistence": {
          "$ref": "#/$defs/storage"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "grafana": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "adminPassword": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "autoAssignOrgRole": {
          "type": "string",
          "enum": [
            "Viewer",
            "Editor",
            "Admin"
          ]
        },
        "persistence": {
          "$ref": "#/$defs/storage"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "sidecar": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "label": {
              "type": "string"
            },
            "labelValue": {
              "type": "string"
            },
            "datasourceLabel": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            }
          }
        }
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storageClass": {
          "type": "string"
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string"
            }
          }
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "externalUrl": {
      "type": "string",
      "pattern": "^$|^https?://"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "handbrake": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "env": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "USER_ID": {
              "type": [
                "integer",
                "string"
              ]
            },
            "GROUP_ID": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "webPort": {
              "type": "integer"
            },
            "vncPort": {
              "type": "integer"
            },
            "nodePort": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "config": {
          "$ref": "#/$defs/storage"
        },
        "watch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hostPath": {
              "type": "string"
            },
            "existingClaim": {
              "type": "string"
            },
            "readOnly": {
              "type": "boolean"
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hostPath": {
              "type": "string"
            },
            "existingClaim": {
              "type": "string"
            },
            "readOnly": {
              "type": "boolean"
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hostPath": {
              "type": "string"
            },
            "existingClaim": {
              "type": "string"
            },
            "readOnly": {
              "type": "boolean"
            }
          }
        },
        "dri": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    }
  }
}
