# Copy to deploy/.env and fill in, then `docker compose up -d`.
# For a zero-config trial you do NOT need this file — use the bundled IdP:
#   docker compose -f docker-compose.yml -f docker-compose.dev-idp.yml up -d
# Anything unset here falls back to the DEVELOPMENT defaults in
# docker-compose.yml (database password "ontele", a fixed cookie secret, the
# Dex issuer); always set the secrets below for a real deployment.
# ---- Postgres ----
POSTGRES_USER=ontele
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=ontele

# ---- Library paths on the host ----
MEDIA_DIR=/tank/media        # movies + tv (mounted read-only)
MUSIC_DIR=/tank/music        # mounted read-only
RECORDINGS_DIR=/tank/dvr     # DVR output (read-write)

# ---- Ontele bootstrap (first run only; Settings page owns them afterwards) ----
ONTELE_XMLTV=                # e.g. /data/guide/xmltv.xml.gz or https://…
ONTELE_HDHR=                 # tuner IP when UDP discovery can't cross the container network
ONTELE_COMMERCIALS=skip      # off | skip | delete
ONTELE_TMDB_API_KEY=         # https://www.themoviedb.org/settings/api
ONTELE_ADMIN_USERS=you@example.com   # comma-separated emails/usernames that are admins
ONTELE_ADMIN_GROUPS=

# ---- oauth2-proxy (identity) ----
# Provider docs: https://oauth2-proxy.github.io/oauth2-proxy/configuration/providers/
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=https://accounts.google.com   # any OIDC issuer (Authentik, Keycloak, Entra, Okta…)
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# python3 -c 'import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_REDIRECT_URL=http://localhost:4180/oauth2/callback
OAUTH2_PROXY_COOKIE_SECURE=false   # true when served over https
OAUTH2_PROXY_SCOPE=openid email profile

# ---- Grafana ----
GF_SECURITY_ADMIN_PASSWORD=admin
